PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret

# --- Database (optional) -------------------------------------------
# Leave commented to use the local JSON file. Uncomment only if MongoDB is running.
# MONGODB_URI=mongodb://127.0.0.1:27017/slicecraft

# --- Email via Gmail (optional, enables real emails) ---------------
# Google Account > Security > 2-Step Verification > App passwords
# EMAIL_USER=yourname@gmail.com
# EMAIL_PASS=your-16-char-app-password
# Admin email that receives low-stock alerts (defaults to EMAIL_USER)
# ADMIN_EMAIL=yourname@gmail.com

# --- Razorpay TEST mode (optional) ---------------------------------
# https://dashboard.razorpay.com > Test Mode > Settings > API Keys
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- Low stock job --------------------------------------------------
LOW_STOCK_THRESHOLD=20
# node-cron expression (default: every 5 minutes)
STOCK_CRON=*/5 * * * *
