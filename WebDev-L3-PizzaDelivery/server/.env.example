PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pizzaapp
JWT_SECRET=change_me
CLIENT_URL=http://localhost:5173
# Razorpay TEST keys (dashboard.razorpay.com -> Test Mode -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Gmail example: use an App Password. Leave SMTP_HOST empty to just print emails in the terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
# Admin account is auto-created on first start
ADMIN_EMAIL=admin@pizza.com
ADMIN_PASSWORD=Admin@123
